# Settings for running without Docker: copy this file to .env, edit it, then `make run`.
# (.env is ignored by git, so your provider credentials stay out of the repository.)

# Your provider's playlist URL. Several playlists: put the URLs in quotes, separated by spaces.
ORIGINAL_M3U_URL=http://your-provider.example/get.php?username=USER&password=PASS&type=m3u_plus
# The local IP address of this machine (used in the playlist served to your IPTV apps).
HOST_IP=192.168.1.2

# Optional:
# NUMBER_OF_CLIENTS=3
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# UPSTREAM_USER_AGENT=VLC/3.0.23 LibVLC/3.0.23
# LOG_LEVEL=INFO
